<root>
  <template name="charsheet_sub_defenses">
    <subwindow>
      <anchored position="insidetopleft" width="270" height="105" />
      <class>char_header_defenses</class>
      <activate />
    </subwindow>
  </template>

  <windowclass name="char_header_defenses">
    <sheetdata>
      <anchor_content_top />

      <frame_char name="frame">
        <anchored position="over" />
      </frame_char>

      <label_charframetop name="header">
        <anchored to="contentanchor" height="20">
          <top relation="relative" offset="2" postoffset="7" />
          <left offset="10" />
          <right offset="-10" />
        </anchored>
        <static textres="char_label_combat_defenses" />
      </label_charframetop>
      
      <sub_content_top name="defenses">
        <anchored>
          <left anchor="center" offset="-125" />
          <right anchor="center" offset="125" />
        </anchored>
        <class>common_content_defenses</class>
      </sub_content_top>
    </sheetdata>
  </windowclass>
	
</root>
