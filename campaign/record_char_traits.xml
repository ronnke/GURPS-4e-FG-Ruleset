<root>
  <windowclass name="charsheet_traits">
    <script file="campaign/scripts/char_traits.lua" />
    <sheetdata>
      <anchor_content_top />
      <anchor_content_bottom />

      <sub_content_framed_groupbox name="content">
        <class>charsheet_traits_contents</class>
      </sub_content_framed_groupbox>
      <scrollbar_content />
    </sheetdata>
  </windowclass>
  
  <windowclass name="charsheet_traits_contents">
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
	      updateVisibility(bReadOnly);
      end      
      function updateVisibility(bReadOnly)
	      local node = getDatabaseNode();
	      if not node then
		      return;
	      end

	      advantages.setVisible(not bReadOnly or CharManager.hasAdvantages(node));
	      perks.setVisible(not bReadOnly or CharManager.hasPerks(node));
	      disadvantages.setVisible(not bReadOnly or CharManager.hasDisadvantages(node));
	      quirks.setVisible(not bReadOnly or CharManager.hasQuirks(node));
        features.setVisible(not bReadOnly or CharManager.hasFeatures(node));
      end
    </script>
    <sheetdata>
      <anchor_content_top />

      <sub_content_top name="advantages">
        <class>charsheet_traits_advantages</class>
      </sub_content_top>
      <sub_content_top name="perks">
        <class>charsheet_traits_perks</class>
      </sub_content_top>
      <sub_content_top name="disadvantages">
        <class>charsheet_traits_disadvantages</class>
      </sub_content_top>
      <sub_content_top name="quirks">
        <class>charsheet_traits_quirks</class>
      </sub_content_top>
      <sub_content_top name="features">
        <class>charsheet_traits_features</class>
      </sub_content_top>
    </sheetdata>
  </windowclass>

  <windowclass name="charsheet_traits_list">
    <margins control="0,0,0,2" />
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "list_iadd", }, bReadOnly);
      end
    </script>
    <sheetdata>
      <anchor_content_top />

      <label_charframetop name="header">
        <anchored to="contentanchor" height="20">
          <top relation="relative" offset="2" postoffset="2" />
          <left offset="10" />
          <right offset="-10" />
        </anchored>
        <icons>char_traits</icons>
      </label_charframetop>
      
      <button_iadd name="list_iadd">
        <anchored to="header" position="insidetopright" offset="5,0" />
        <target>list</target>
      </button_iadd>

      <list_content_labeled_alternating_top name="list">
        <anchored>
          <left offset="5" />
          <right offset="-5" />
        </anchored>
      </list_content_labeled_alternating_top>
      
      <anchor_list_content_label_left />
      <anchor_list_content_label_right />
      <spacer_list_content_idelete_label_left name="idelete_header" />
      <spacer_list_content_link_label_left name="spacer_link" />

      <label_list_content_number_right name="label_points">
        <anchored width="40" />
        <static textres="char_traits_label_points" />
      </label_list_content_number_right>
      
      <label_list_content_noframe name="label_name">
        <static textres="char_traits_label_name" />
      </label_list_content_noframe>

    </sheetdata>
  </windowclass>

  <windowclass name="charsheet_traits_advantages" copy="charsheet_traits_list">
    <sheetdata>
      <label_charframetop name="header">
        <static textres="char_traits_label_advantages" />
        <icons>char_traits_advantages</icons>
      </label_charframetop>

      <list_content_labeled_alternating_top name="list">
        <datasource>.traits.adslist</datasource>
        <class>char_trait_advantage</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating_top>
      
    </sheetdata>
  </windowclass>

  <windowclass name="charsheet_traits_perks" copy="charsheet_traits_list">
    <sheetdata>
      <label_charframetop name="header">
        <static textres="char_traits_label_perks" />
        <icons>char_traits_perks</icons>
      </label_charframetop>

      <list_content_labeled_alternating_top name="list">
        <datasource>.traits.perkslist</datasource>
        <class>char_trait_advantage</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating_top>

    </sheetdata>
  </windowclass>

  <windowclass name="charsheet_traits_disadvantages" copy="charsheet_traits_list">
    <sheetdata>
      <label_charframetop name="header">
        <static textres="char_traits_label_disadvantages" />
        <icons>char_traits_disadvantages</icons>
      </label_charframetop>

      <list_content_labeled_alternating_top name="list">
        <datasource>.traits.disadslist</datasource>
        <class>char_trait_disadvantage</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating_top>
    </sheetdata>
  </windowclass>

  <windowclass name="charsheet_traits_quirks" copy="charsheet_traits_list">
    <sheetdata>
      <label_charframetop name="header">
        <static textres="char_traits_label_quirks" />
        <icons>char_traits_quirks</icons>
      </label_charframetop>

      <list_content_labeled_alternating_top name="list">
        <datasource>.traits.quirkslist</datasource>
        <class>char_trait_disadvantage</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating_top>
    </sheetdata>
  </windowclass>

  <windowclass name="charsheet_traits_features" copy="charsheet_traits_list">
    <sheetdata>
      <label_charframetop name="header">
        <static textres="char_traits_label_features" />
        <icons>char_traits_features</icons>
      </label_charframetop>
      
      <list_content_labeled_alternating_top name="list">
        <datasource>.traits.featureslist</datasource>
        <class>char_trait_feature</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating_top>
    </sheetdata>
  </windowclass>

  <windowclass name="charsheet_trait_item">
    <margins control="0,0,0,2" />
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "name", "points", "idelete" }, bReadOnly);
      end
    </script>
    <sheetdata>
      <anchor_listitem_left_sm />
      <anchor_listitem_right_sm />

      <button_listitem_idelete_left name="idelete" />
      <linkc_listitem_left name="shortcut" />

      <number_listitem_right name="points">
        <anchored width="40" />
        <frame mergerule="replace" name="fielddark" offset="5,5,5,5" hidereadonly="true" />
        <color>#808080</color>
        <nodrag />
      </number_listitem_right>

      <string_listitem_center name="name">
        <delaykeyupdate />
      </string_listitem_center>
    
  </sheetdata>
  </windowclass>

  <windowclass name="char_trait_advantage"  copy="charsheet_trait_item">
    <sheetdata>

      <linkc_listitem_left name="shortcut">
        <class>trait_advantage</class>
      </linkc_listitem_left>

      <number_listitem_right name="points">
        <min>0</min>
      </number_listitem_right>
    
  </sheetdata>
  </windowclass>

  <windowclass name="char_trait_disadvantage" copy="charsheet_trait_item">
    <sheetdata>

      <linkc_listitem_left name="shortcut">
        <class>trait_disadvantage</class>
      </linkc_listitem_left>

      <number_listitem_right name="points">
        <max>0</max>
      </number_listitem_right>

    </sheetdata>
  </windowclass>

  <windowclass name="char_trait_feature"  copy="charsheet_trait_item">
    <sheetdata>

      <linkc_listitem_left name="shortcut">
        <class>trait_feature</class>
      </linkc_listitem_left>

    </sheetdata>
  </windowclass>

</root>
