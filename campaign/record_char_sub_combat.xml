  <windowclass name="charsheet_combat_contents">
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
	      updateVisibility(bReadOnly);
      end      
      function updateVisibility(bReadOnly)
	      local node = getDatabaseNode();
	      if not node then
		      return;
	      end

	      meleecombat.setVisible(not bReadOnly or CharManager.hasMeleeWeapons(node));
	      rangedcombat.setVisible(not bReadOnly or CharManager.hasRangedWeapons(node));
	      defenses.setVisible(not bReadOnly or CharManager.hasDefenses(node));
      end
    </script>
    <sheetdata>
      <anchor_content_top />
      <scrollbar />

      <sub_content_top name="meleecombat">
        <anchored>
          <top position="relative" postoffset="10" />
        </anchored>
        <class>charsheet_meleecombat</class>
      </sub_content_top>
      <sub_content_top name="rangedcombat">
        <anchored>
          <top position="relative" postoffset="10" />
        </anchored>
        <class>charsheet_rangedcombat</class>
      </sub_content_top>
      <sub_content_top name="defenses">
        <anchored>
          <top position="relative" postoffset="10" />
        </anchored>
        <class>charsheet_defenses</class>
      </sub_content_top>
    </sheetdata>
  </windowclass>
  
</root>
