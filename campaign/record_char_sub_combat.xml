<root>
  <template name="charsheet_sub_combat">
    <subwindow name="content">
      <anchored>
        <top offset="240" />
        <left offset="10" />
        <right offset="-10" />
        <bottom offset="-10" />
      </anchored>
      <frame name="groupbox" offset="10,10,10,10" />
      <class>charsheet_combat_contents</class>
      <activate />
    </subwindow>
  </template>

  <!--<windowclass name="charsheet_traits">
