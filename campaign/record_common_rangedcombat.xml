<root>

  <windowclass name="common_list_rangedweapon">
		<script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "list_iadd", }, bReadOnly);
      end
      function onDrop(x, y, draginfo)
        if not draginfo.isType("shortcut") then
          return;
        end

        local _, sRecord = draginfo.getShortcutData();
        if LibraryDataGURPS4e.isRangedWeapon(sRecord) then
          return ItemManager.handleAnyDrop(getDatabaseNode(), draginfo);
        end
      end      
    </script>
		<sheetdata>
      <anchor_content_top />
      <anchor_content_bottom />

      <label_charframetop name="header">
        <anchored to="contentanchor" height="20">
          <top relation="relative" offset="2" postoffset="2" />
          <left offset="10" />
          <right offset="-10" />
        </anchored>
        <static textres="char_label_combat_ranged" />
        <icons>char_combat_ranged</icons>
      </label_charframetop>

      <button_iadd name="list_iadd">
        <anchored to="header" position="insidetopright" offset="5,0" />
        <target>list</target>
      </button_iadd>

      <list_content_labeled_alternating_top name="list">
        <anchored>
          <left offset="5" />
          <right offset="-5" />
        </anchored>
        <datasource>.combat.rangedcombatlist</datasource>
        <class>common_listitem_rangedweapon</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating_top>
      <scrollbar_list />

      <anchor_list_content_label_left />
      <anchor_list_content_label_right />
      <spacer_list_content_idelete_label_left name="idelete_header" />
      <spacer_list_content_link_label_left name="spacer_shortcut" />

      <label_list_content_number_right name="label_ammo">
        <anchored width="45" />
        <static textres="char_label_ammo" />
      </label_list_content_number_right>

      <label_list_content_string_right name="label_tl">
        <anchored width="20" />
        <center />
        <static textres="char_label_tl" />
      </label_list_content_string_right>

      <label_list_content_string_right name="label_lc">
        <anchored width="20" />
        <center />
        <static textres="char_label_lc" />
      </label_list_content_string_right>

      <label_list_content_number_right name="label_bulk">
        <anchored width="35" />
        <static textres="char_label_bulk" />
      </label_list_content_number_right	>

      <label_list_content_string_right name="label_st">
        <anchored width="20" />
        <center />
        <static textres="char_label_st" />
      </label_list_content_string_right>

      <spacer_list_content_button_label_right name="spacer_modifiers" />
      <spacer_list_content_button_label_right name="spacer_modes" />

      <label_list_content_noframe name="label_weapon">
        <center />
        <static textres="char_label_weapon" />
      </label_list_content_noframe>
			
		</sheetdata>
	</windowclass>

  <windowclass name="common_listitem_rangedweapon">
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
        self.onBulkChanged()
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "name", "st", "bulk", "lc", "tl", "shortcut", "idelete" }, bReadOnly);
        WindowManager.callSafeControlsSetVisible(self, { "bulk" }, not bReadOnly);
        WindowManager.callSafeControlsSetVisible(self, { "button_bulk" }, bReadOnly);
      end
      function onBulkChanged()
        local value = tonumber(bulk.getValue()) or 0;
        button_bulk.setTooltipText("Bulk: " .. value);
      end
    </script>
    <sheetdata>
      <anchor_content_top />
      <anchor_listitem_left_sm />
      <anchor_listitem_right_sm />

      <button_listitem_idelete_left name="idelete" />

      <link_listitem_left name="shortcut">
        <tabtarget prev="ammo" />
      </link_listitem_left>

      <number_listitem_right name="ammo">
        <anchored width="45" />
        <tabtarget next="shortcut" prev="tl" />
      </number_listitem_right>

      <string_listitem_right name="tl">
        <anchored width="20" />
        <center />
        <tabtarget next="ammo" prev="lc" />
      </string_listitem_right>

      <string_listitem_right name="lc">
        <anchored width="20" />
        <center />
        <tabtarget next="tl" prev="bulk" />
      </string_listitem_right>

      <number_listitem_right name="bulk">
        <anchored width="35" />
        <frame mergerule="replace" name="fielddark" offset="5,5,5,5" hidereadonly="true" />
        <tabtarget next="ammo" prev="button_bulk" />
        <script>
          function onValueChanged()
            window.onBulkChanged();
          end
        </script>
      </number_listitem_right>

      <button_listitem_mod_right name="button_bulk">
        <anchored>
          <right position="relative" offset="-13" postoffset="-12" />
        </anchored>
        <icon normal="button_action_modifier" pressed="button_action_modifier_down" />
        <tooltip textres="char_tooltip_apply_bulk" />
        <targetname>Bulk</targetname>
        <targetvalue>bulk</targetvalue>
        <tabtarget next="bulk" prev="st" />
      </button_listitem_mod_right>

      <string_listitem_right name="st">
        <anchored width="20" />
        <center />
        <tabtarget next="buttton_bulk" prev="imodifier" />
      </string_listitem_right>

      <button_listitem_isection_right name="imodifier">
        <state icon="modifiers" tooltipres="char_tooltip_modifiers" merge="resetandadd" />
        <state icon="modifiers_down" merge="add" />
        <target>modifiers</target>
        <tabtarget next="st" prev="imodes" />
      </button_listitem_isection_right>

      <button_listitem_isection_right name="imodes">
        <state icon="weapon_modes" tooltipres="char_tooltip_weaponmodes" merge="resetandadd" />
        <state icon="weapon_modes_down" merge="add" />
        <target>modes</target>
        <tabtarget next="imodifier" prev="name" />
      </button_listitem_isection_right>

      <string_listitem_narrow_center name="name">
        <delaykeyupdate />
        <tabtarget next="imodes" />
      </string_listitem_narrow_center>

      <spacer_content_top name="spacer_section">
        <anchored height="20" />
      </spacer_content_top>

      <!--Modes Section-->
      <sub_content_section_top name="modes">
        <class>common_list_rangedweaponmode</class>
      </sub_content_section_top>

      <!--Modifiers Section-->
      <sub_content_section_top name="modifiers">
        <class>common_list_modifier</class>
      </sub_content_section_top>

      <spacer_content_top name="spacer_bottom" />

    </sheetdata>
  </windowclass>

  <windowclass name="common_list_rangedweaponmode">
	<script>
    function onInit()
      self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
    end
    function onLockModeChanged(bReadOnly)
      WindowManager.callSafeControlsSetLockMode(self, { "list_iadd", }, bReadOnly);
    end
  </script>
	<sheetdata>
    <anchor_content_top />
    <anchor_content_bottom />

    <frame_char name="frame">
      <anchored position="over" />
    </frame_char>

    <list_content_noscroll_alternating_top name="list">
      <anchored>
        <top position="relative" offset="10" />
      </anchored>
      <datasource>.rangedmodelist</datasource>
      <class>common_listitem_rangedweaponmode</class>
      <sortby><control>name</control></sortby>
      <newfocus>name</newfocus>
    </list_content_noscroll_alternating_top>

    <button_iadd name="list_iadd">
      <anchored to="list" position="belowright" offset="5,5" />
      <target>list</target>
    </button_iadd>

    <anchor_list_content_label_left_sm />
    <anchor_list_content_label_right_sm />
    <spacer_list_content_idelete_label_left name="idelete_header" />

    <spacer_list_content_button_label_right name="spacer_details">
      <anchored width="22" />
    </spacer_list_content_button_label_right>

    <label_listitem_number_narrow_right_sm name="label_acc">
      <anchored width="25" />
      <static textres="char_label_acc" />
    </label_listitem_number_narrow_right_sm>

    <label_listitem_string_narrow_right_sm name="label_damage">
      <anchored width="120" />
      <center />
      <static textres="char_label_damage" />
    </label_listitem_string_narrow_right_sm>

    <label_listitem_number_narrow_right_sm name="label_lvl">
      <anchored width="20" />
      <static textres="char_label_level" />
    </label_listitem_number_narrow_right_sm>

    <spacer_list_content_button_label_right name="spacer_acc" />
    <spacer_list_content_button_label_right name="spacer_halfdamage" />
    <spacer_list_content_button_label_right name="spacer_damage" />
    <spacer_list_content_button_label_right name="spacer_attack" />

    <label_listitem_string_narrow_noframe_sm name="label_modes">
      <center />
      <static textres="char_label_mode" />
    </label_listitem_string_narrow_noframe_sm>

	</sheetdata>
</windowclass>

  <windowclass name="common_listitem_rangedweaponmode">
    <margins control="0,0,2,2" />
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
        self.onAccChanged()
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "name", "level", "damage", "acc", "idelete" }, bReadOnly);
      end
      function onAccChanged()
        local value = tonumber(acc.getValue()) or 0;
        button_acc.setTooltipText("Acc: " .. value);
      end
    </script>
    <sheetdata>
      <anchor_content_top />
      <anchor_listitem_left_sm />
      <anchor_listitem_right_sm />

      <button_listitem_idelete_left name="idelete" />

      <button_listitem_isection_right name="idetails">
        <state icon="button_details" tooltipres="char_tooltip_weaponmodes" merge="resetandadd" />
        <state icon="button_details_down" merge="add" />
        <target>details</target>
        <tabtarget prev="acc" />
      </button_listitem_isection_right>
      
      <number_listitem_narrow_right name="acc">
        <anchored width="25" />
        <displaysign />
        <tabtarget next="imodes" prev="damage" />
        <script>
          function onValueChanged()
            window.onAccChanged();
          end
        </script>
      </number_listitem_narrow_right>

      <string_listitem_narrow_right name="damage">
        <anchored width="120" />
        <tabtarget next="acc" prev="level" />
      </string_listitem_narrow_right>

      <number_listitem_narrow_right name="level">
        <anchored width="20" />
        <tabtarget next="damage" prev="button_acc" />
      </number_listitem_narrow_right>

      <button_listitem_mod_right name="button_acc">
        <icon normal="button_action_modifier" pressed="button_action_modifier_down" />
        <tooltip textres="char_tooltip_apply_acc" />
        <targetname>Acc</targetname>
        <targetvalue>acc</targetvalue>
        <tabtarget next="level" prev="button_halfdamage" />
      </button_listitem_mod_right>

      <button_listitem_rollable_right name="button_halfdamage">
        <rollable_button_halfdamage />
        <icon normal="button_action_halfdamage" pressed="button_action_halfdamage_down" />
        <tooltip textres="char_tooltip_roll_halfdamage" />
        <tabtarget next="button_acc" prev="button_damage" />
      </button_listitem_rollable_right>

      <button_listitem_rollable_right name="button_damage">
        <rollable_button_damage />
        <icon normal="button_action_damage" pressed="button_action_damage_down" />
        <tooltip textres="char_tooltip_roll_damage" />
        <tabtarget next="button_halfdamage" prev="button_attack" />
      </button_listitem_rollable_right>

      <button_listitem_rollable_right name="button_attack">
        <rollable_button_ranged />
        <icon normal="button_action_attack" pressed="button_action_attack_down" />
        <tooltip textres="char_tooltip_roll_attack" />
        <tabtarget next="button_damage" prev="name" />
      </button_listitem_rollable_right>

      <string_listitem_narrow_center name="name">
        <delaykeyupdate />
        <tabtarget next="button_attack" />
      </string_listitem_narrow_center>

      <spacer_content_top name="spacer_section">
        <anchored height="20" />
      </spacer_content_top>

      <!--Details Section-->
      <sub_content_top name="details">
        <class>common_rangedweaponmode_detail</class>
      </sub_content_top>

      <spacer_content_top name="spacer_bottom" />

		</sheetdata>
	</windowclass>

