      <label_fieldtop>
        <anchored to="range" />
        <font>sheetlabelsmall</font>
        <static textres="char_label_range" />
      </label_fieldtop>

      <string_listitem_narrow_left name="rof">
        <anchored width="20" />
        <center />
        <tabtarget next="shots" prev="range" />
      </string_listitem_narrow_left>
      <label_fieldtop>
        <anchored to="rof" />
        <font>sheetlabelsmall</font>
        <static textres="char_label_rof" />
      </label_fieldtop>

      <string_listitem_narrow_left name="shots">
        <anchored width="30" />
        <center />
        <tabtarget next="rcl" prev="rof" />
      </string_listitem_narrow_left>
      <label_fieldtop>
        <anchored to="shots" />
        <font>sheetlabelsmall</font>
        <static textres="char_label_shots" />
