<root>

  <template name="string_enc_right">
    <simplestring>
      <frame mergerule="replace" name="fielddark" offset="10,5,10,5" hidereadonly="true" />
      <stateframe>
        <keyedit name="fieldfocus" offset="10,5,10,5" />
        <hover name="fieldfocus" offset="10,5,10,5" hidereadonly="true" />
        <drophilight name="fieldfocus" offset="10,5,10,5" hidereadonly="true" />
      </stateframe>
      <nodrag />
      <center />
    </simplestring>
  </template>

  <template name="string_listitem_enc_right">
    <string_listitem_right>
      <anchored width="25">
        <right anchor="left" relation="relative" offset="-5" />
      </anchored>
      <nodrag />
      <center />
    </string_listitem_right>
  </template>

  <windowclass name="charsheet_sub_encumbrance">
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "list_iadd", }, bReadOnly);
        WindowManager.callSafeControlsSetLockMode(self, { "enc_xhvy", "enc_hvy", "enc_medium", "enc_light", "enc_none" }, bReadOnly);
        WindowManager.callSafeControlsSetLockMode(self, { "enc_move_xhvy", "enc_move_hvy", "enc_move_medium", "enc_move_light", "enc_move_none" }, bReadOnly);
        WindowManager.callSafeControlsSetLockMode(self, { "enc_dodge_xhvy", "enc_dodge_hvy", "enc_dodge_medium", "enc_dodge_light", "enc_dodge_none" }, bReadOnly);
      end
    </script>
    <sheetdata>
      <anchor_content_top />
      <anchor_content_bottom />
      
      <!-- Move and Encumbrance -->

      <frame_char name="frame">
        <anchored position="insidetopleft">
          <right />
          <bottom />
        </anchored>
      </frame_char>

      <label_charframetop name="header">
        <anchored to="contentanchor" height="20">
          <top relation="relative" offset="25" postoffset="2" />
          <left offset="10" />
          <right offset="-10" />
        </anchored>
        <static textres="char_label_encumbrance" />
      </label_charframetop>

      <button_iadd name="list_iadd">
        <anchored to="header" position="insidetopright" offset="5,0" />
        <target>list</target>
      </button_iadd>

      <!-- Encumbrance Table -->
      
      <button_checkbox name="enc_4" source="encumbrance.enc_4">
         <anchored to="contentanchor" width="35" height="20">
          <top relation="relative" offset="2" postoffset="0" />
          <right offset="-15" />
        </anchored>
        <readonly />
      </button_checkbox>
      <button_checkbox name="enc_3" source="encumbrance.enc_3">
        <anchored to="enc_4" width="35" height="20">
          <top />
          <right anchor="left" relation="relative" offset="-5" />
        </anchored>
        <readonly />
      </button_checkbox>
      <button_checkbox name="enc_2" source="encumbrance.enc_2">
        <anchored to="enc_4" width="35" height="20">
          <top />
          <right anchor="left" relation="relative" offset="-5" />
        </anchored>
        <readonly />
      </button_checkbox>
      <button_checkbox name="enc_1" source="encumbrance.enc_1">
        <anchored to="enc_4" width="35" height="20">
          <top />
          <right anchor="left" relation="relative" offset="-5" />
        </anchored>
        <readonly />
      </button_checkbox>
      <button_checkbox name="enc_0" source="encumbrance.enc_0">
        <anchored to="enc_4" width="35" height="20">
          <top />
          <right anchor="left" relation="relative" offset="-5" />
        </anchored>
        <readonly />
      </button_checkbox>

      <label_columntop name="enc_xheavy_label">
        <anchored to="contentanchor" position="insidetopright" width="35" height="20">
          <top relation="relative" offset="-5" postoffset="0" />
          <right offset="-15" />
        </anchored>
				<static textres="char_label_encumbrancexheavy" />
			</label_columntop>
			<label_columntop name="enc_heavy_label">
				<anchored to="enc_xheavy_label" width="35" height="20">
					<top/>
					<right anchor="left" relation="relative" offset="-5" />
				</anchored>
				<static textres="char_label_encumbranceheavy" />
			</label_columntop>
			<label_columntop name="enc_medium_label">
				<anchored to="enc_xheavy_label" width="35" height="20">
					<top	/>
					<right anchor="left" relation="relative" offset="-5" />
				</anchored>
				<static textres="char_label_encumbrancemedium" />
			</label_columntop>
			<label_columntop name="enc_light_label">
				<anchored to="enc_xheavy_label" width="35" height="20">
					<top />
					<right anchor="left" relation="relative" offset="-5" />
				</anchored>
				<static textres="char_label_encumbrancelight" />
			</label_columntop>
			<label_columntop name="enc_none_label">
				<anchored to="enc_xheavy_label" width="35" height="20">
          <top />
          <right anchor="left" relation="relative" offset="-5" />
				</anchored>
				<static textres="char_label_encumbrancenone" />
			</label_columntop>

			<!-- Weight -->
      <string_enc_right name="enc_xhvy" source="encumbrance.enc4_weight">
        <anchored to="contentanchor" position="insidetopright" width="25" height="20">
          <top relation="relative" offset="2" postoffset="2" />
          <right offset="-20" />
        </anchored>
			</string_enc_right>
      <string_enc_right name="enc_hvy" source="encumbrance.enc3_weight">
				<anchored to="enc_xhvy" width="25" height="20">
          <top />
          <right anchor="left" relation="relative" offset="-15" />
        </anchored>
			</string_enc_right>
      <string_enc_right name="enc_medium" source="encumbrance.enc2_weight">
				<anchored to="enc_xhvy" width="25" height="20">
          <top />
          <right anchor="left" relation="relative" offset="-15" />
        </anchored>
			</string_enc_right>
      <string_enc_right name="enc_light" source="encumbrance.enc1_weight">
        <anchored to="enc_xhvy" width="25" height="20">
          <top />
          <right  anchor="left" relation="relative" offset="-15" />
        </anchored>
			</string_enc_right>
      <string_enc_right name="enc_none" source="encumbrance.enc0_weight">
        <anchored to="enc_xhvy" width="25" height="20">
          <top />
          <right anchor="left" relation="relative" offset="-15" />
        </anchored>
			</string_enc_right>
      <stringcontrol>
        <anchored to="enc_xhvy" height="20">
          <top />
          <left parent="contentanchor" offset="15" />
          <right anchor="left" relation="relative" offset="-15" />
        </anchored>
        <static textres="char_label_weight" />
      </stringcontrol>


			<!-- Move -->
      <string_enc_right name="enc_move_xhvy" source="encumbrance.enc4_move" >
        <anchored to="contentanchor" position="insidetopright" width="25" height="20">
          <top relation="relative" offset="2" postoffset="2" />
          <right offset="-20" />
        </anchored>
				<tabtarget prev="enc_move_hvy" next="enc_dodge_none" />
      </string_enc_right>
      <string_enc_right name="enc_move_hvy" source="encumbrance.enc3_move">
				<anchored to="enc_move_xhvy" width="25" height="20">
          <top />
          <right anchor="left" relation="relative" offset="-15" />
        </anchored>
			</string_enc_right>
      <string_enc_right name="enc_move_medium" source="encumbrance.enc2_move">
				<anchored to="enc_move_xhvy" width="25" height="20">
					<top />
					<right anchor="left" relation="relative" offset="-15" />
				</anchored>
			</string_enc_right>
      <string_enc_right name="enc_move_light" source="encumbrance.enc1_move">
				<anchored to="enc_move_xhvy" width="25" height="20">
					<top />
					<right anchor="left" relation="relative" offset="-15" />
				</anchored>
			</string_enc_right>
      <string_enc_right name="enc_move_none" source="encumbrance.enc0_move">
				<anchored to="enc_move_xhvy" width="25" height="20">
					<top />
					<right anchor="left" relation="relative" offset="-15" />
				</anchored>
			</string_enc_right>
			<stringcontrol>
				<anchored to="enc_move_xhvy" height="20">
          <top />
          <left parent="contentanchor" offset="15" />
          <right anchor="left" relation="relative" offset="-15" />
        </anchored>
        <static textres="char_label_move" />
			</stringcontrol>

			<!-- Dodge -->
			<number_charfield name="enc_dodge_xhvy" source="encumbrance.enc4_dodge">
				<rollable_dodge />
        <anchored to="contentanchor" width="25" height="20">
          <top relation="relative" offset="2" postoffset="2" />
          <right offset="-20" />
        </anchored>
				<center />
				<tabtarget prev="enc_dodge_hvy" next="enc_none" />
			</number_charfield>
			<number_charfield name="enc_dodge_hvy" source="encumbrance.enc3_dodge">
				<rollable_dodge />
				<anchored to="enc_dodge_xhvy" width="25" height="20">
					<top />
					<right anchor="left" relation="relative" offset="-15" />
				</anchored>
				<center />
				<tabtarget prev="enc_dodge_medium" next="enc_dodge_xhvy" />
			</number_charfield>
			<number_charfield name="enc_dodge_medium" source="encumbrance.enc2_dodge">
				<rollable_dodge />
				<anchored to="enc_dodge_xhvy" width="25" height="20">
					<top />
					<right anchor="left" relation="relative" offset="-15" />
				</anchored>
				<center />
				<tabtarget prev="enc_dodge_light" next="enc_dodge_hvy" />
			</number_charfield>
			<number_charfield name="enc_dodge_light" source="encumbrance.enc1_dodge">
				<rollable_dodge />
				<anchored to="enc_dodge_xhvy" width="25" height="20">
					<top />
					<right anchor="left" relation="relative" offset="-15" />
				</anchored>
				<center />
				<tabtarget prev="enc_dodge_none" next="enc_dodge_medium" />
			</number_charfield>
			<number_charfield name="enc_dodge_none" source="encumbrance.enc0_dodge">
				<rollable_dodge />
				<anchored to="enc_dodge_xhvy" width="25" height="20">
					<top />
					<right anchor="left" relation="relative" offset="-15" />
				</anchored>
				<center />
				<tabtarget prev="enc_move_xhvy" next="enc_dodge_light" />
			</number_charfield>
			<stringcontrol>
				<anchored to="enc_dodge_xhvy" width="60" height="20">
          <top />
          <left parent="contentanchor" offset="15" />
        </anchored>
				<static textres="char_label_dodge" />
			</stringcontrol>

      <!-- Encumbrance List -->
      
      <list_content_alternating name="list">
        <anchored>
          <top relation="relative" offset="5" postoffset="2" />
          <left offset="15" />
          <right offset="-15" />
          <bottom offset="-10" />
        </anchored>
        <datasource>.encumbrance.encumbrancelist</datasource>
        <class>char_encumbrance</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_alternating>
      <scrollbar_list />
      
		
  </sheetdata>
	</windowclass>

	<windowclass name="char_encumbrance">
		<margins control="0,0,0,2" />
		<script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "name", "none", "light", "medium", "heavy", "xheavy", "idelete" }, bReadOnly);
      end
    </script>		
    <sheetdata>
      <anchor_listitem_left_sm />
      <anchor_listitem_right_sm />

      <button_listitem_idelete_left name="idelete" />

      <string_listitem_enc_right name="xheavy" />
      <string_listitem_enc_right name="heavy" />
      <string_listitem_enc_right name="medium" />
      <string_listitem_enc_right name="light" />
      <string_listitem_enc_right name="none" />
      <string_listitem_center name="name" />
  
    </sheetdata>
	</windowclass>
	
</root>
