<root>
	
  <windowclass name="npc_abilities">
    <script>
      function onDrop(x, y, draginfo)
        if draginfo.isType("shortcut") then
          local sClass, sRecord = draginfo.getShortcutData();
          if LibraryDataGURPS4e.isMeleeWeapon(sRecord) or LibraryDataGURPS4e.isRangedWeapon(sRecord) or LibraryDataGURPS4e.isDefense(sRecord) then
            return ItemManager.handleAnyDrop(getDatabaseNode(), draginfo);
          end
        end
      end
    </script>
    <sheetdata>
      <anchor_content_top />
      <anchor_content_bottom />

      <sub_content name="abilities">
        <class>npc_content_abilities</class>
      </sub_content>

    </sheetdata>
  </windowclass>
  
    <windowclass name="npc_content_abilities">
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        updateVisibility(bReadOnly);
      end
      function updateVisibility(bReadOnly)
        local node = getDatabaseNode();
        if not node then
          return;
        end

        abilities.setVisible(not bReadOnly or CharManager.hasAbilities(node));
     end
    </script>
    <sheetdata>
      <anchor_content_top />
      <anchor_content_bottom />

      <sub_content name="abilities">
        <class>npc_list_abilities</class>
      </sub_content>
      
    </sheetdata>
  </windowclass>

	<windowclass name="npc_list_abilities">
		<script>
			function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "list_iadd" }, bReadOnly);
      end
		</script>
    <sheetdata>
      <anchor_content_top />
      <anchor_content_bottom />

      <label_charframetop name="header">
        <anchored to="contentanchor" height="20">
          <top relation="relative" offset="2" postoffset="2" />
          <left offset="10" />
          <right offset="-10" />
        </anchored>
        <static textres="npc_label_abilities" />
        <icons>char_abilities</icons>
      </label_charframetop>

      <button_iadd name="list_iadd">
        <anchored to="header" position="insidetopright" offset="5,0" />
        <target>list</target>
      </button_iadd>

      <list_content_labeled_alternating name="list">
        <anchored>
          <left offset="10" />
          <right offset="-10" />
          <bottom offset="-10" />
        </anchored>
        <datasource>.abilities.abilitieslist</datasource>
        <class>npc_listitem_ability</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating>
      <scrollbar_list>
        <anchored offset="-10,0" />
      </scrollbar_list>
      
      <anchor_list_content_label_left />
      <anchor_list_content_label_right />
      <spacer_list_content_idelete_label_left name="idelete_header" />

      <label_list_content_number_right name="label_level">
        <anchored width="25" />
        <center />
        <static textres="char_label_abilities_level" />
      </label_list_content_number_right>

      <spacer_list_content_button_label_right name="spacer_modifier" />
      <spacer_list_content_button_label_right name="spacer_roll" />

      <label_list_content_noframe name="label_name">
        <center />
        <static textres="char_label_abilities_name" />
      </label_list_content_noframe>

    </sheetdata>
	</windowclass>

	<windowclass name="npc_listitem_ability">
		<margins control="0,0,0,2" />
		<script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "name", "level", "idelete" }, bReadOnly);
      end
    </script>
		<sheetdata>
      <anchor_content_top />
      <anchor_listitem_left_sm />
      <anchor_listitem_right_sm />

      <button_listitem_idelete_left name="idelete" />

      <number_listitem_right name="level">
        <anchored width="25" />
        <frame mergerule="replace" name="fielddark" offset="5,5,5,5" hidereadonly="true" />
        <center />
        <tabtarget prev="imodifier" />
      </number_listitem_right>

      <button_listitem_isection_right name="imodifier">
        <state icon="modifiers" tooltipres="char_tooltip_modifiers" merge="resetandadd" />
        <state icon="modifiers_down" merge="add" />
        <target>modifiers</target>
        <tabtarget next="level" prev="button_roll" />
      </button_listitem_isection_right>

      <button_listitem_rollable_right name="button_roll">
        <rollable_button_ability />
        <tooltip textres="npc_tooltip_ability" />
        <tabtarget next="imodifier" prev="name" />
      </button_listitem_rollable_right>

      <string_listitem_narrow_center name="name">
        <delaykeyupdate />
        <tabtarget next="button_roll" />
      </string_listitem_narrow_center>

      <spacer_content_top name="spacer_section">
        <anchored height="20" />
      </spacer_content_top>

      <!--Modifiers Section-->
      <sub_content_section_top name="modifiers">
        <class>common_list_modifier</class>
      </sub_content_section_top>

      <spacer_content_top name="spacer_bottom" />
		
		</sheetdata>
	</windowclass>
	
</root>
