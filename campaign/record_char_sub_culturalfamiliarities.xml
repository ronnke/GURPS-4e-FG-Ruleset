<root>
  <template name="charsheet_sub_culturalfamiliarities">
    <subwindow name="content">
      <anchored position="insidetopleft" offset="0,0,0,0" />
      <frame name="groupbox" offset="0,0,0,0" />
      <class>charsheet_culturalfamiliarities_list</class>
      <activate />
    </subwindow>
  </template>

  <!-- Cultural Familiarities -->

  <windowclass name="charsheet_culturalfamiliarities_list">
    <margins control="0,0,0,2" />
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "list_iadd", }, bReadOnly);
      end
    </script>
    <sheetdata>
      <anchor_content_top />
      <anchor_content_bottom />

      <!--<stringcontrol>
        <anchored to="culturalfamiliarityframe" position="insidetopleft" offset="15,10" width="70" height="20" />
        <static>Tech Level:</static>
      </stringcontrol>
      <stringu_charfield name="tech_level" source="traits.tl">
        <anchored to="culturalfamiliarityframe" position="insidetopleft" offset="80,10" width="25" height="20" />
        <center />
      </stringu_charfield>
      <number_charpointfield name="tl_points"  source="traits.tl_points">
        <anchored to="tech_level" position="right" offset="5" width="20" />
      </number_charpointfield>-->

      <label_charframetop name="header">
        <anchored to="contentanchor" height="20">
          <top relation="relative" offset="2" postoffset="2" />
          <left offset="10" />
          <right offset="-10" />
        </anchored>
        <static textres="char_label_culturalfamiliarities" />
      </label_charframetop>

      <button_iadd name="list_iadd">
        <anchored to="header" position="insidetopright" offset="5,0" />
        <target>list</target>
      </button_iadd>

      <list_content_labeled_alternating name="list">
        <anchored>
          <left offset="15" />
          <right offset="-15" />
          <bottom offset="-10" />
        </anchored>
        <datasource>.traits.culturalfamiliaritylist</datasource>
        <class>char_culturalfamiliarity</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating>
      <scrollbar_list />
        
      <anchor_list_content_label_left />
      <anchor_list_content_label_right />
      <spacer_list_content_idelete_label_left name="idelete_header" />

      <label_list_content_number_right name="label_points">
        <anchored width="25" />
        <static textres="char_label_languages_points" />
      </label_list_content_number_right>

      <label_list_content_noframe name="label_name">
        <static textres="char_traits_label_name" />
      </label_list_content_noframe>

    </sheetdata>
  </windowclass>

  <windowclass name="char_culturalfamiliarity">
    <margins control="0,0,0,2" />
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "name", "points", "idelete" }, bReadOnly);
      end
    </script>
    <sheetdata>
      <anchor_listitem_left_sm />
      <anchor_listitem_right_sm />

      <button_listitem_idelete_left name="idelete" />

      <number_listitem_right name="points">
        <anchored width="25" />
        <frame mergerule="replace" name="fielddark" offset="5,5,5,5" hidereadonly="true" />
        <color>#808080</color>
        <nodrag />
      </number_listitem_right>

      <string_listitem_center name="name" />

    </sheetdata>
  </windowclass>
	
</root>
