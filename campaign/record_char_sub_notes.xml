<root>
  <template name="charsheet_sub_notes">
    <subwindow name="content">
      <anchored position="insidetopleft" offset="0,0,0,0" />
      <frame name="groupbox" offset="0,0,0,0" />
      <class>charsheet_notes_list</class>
      <activate />
    </subwindow>
  </template>

  <!-- Notes -->
  <windowclass name="charsheet_notes_list">
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "list_iadd", }, bReadOnly);
      end
    </script>
    <sheetdata>
      <anchor_content_top />
      <anchor_content_bottom />

      <label_charframetop name="header">
        <anchored to="contentanchor" height="20">
          <top relation="relative" offset="2" postoffset="2" />
          <left offset="10" />
          <right offset="-10" />
        </anchored>
        <static textres="char_label_notes" />
      </label_charframetop>

      <button_iadd name="list_iadd">
        <anchored to="header" position="insidetopright" offset="5,0" />
        <target>list</target>
      </button_iadd>

      <list_content_alternating name="list">
        <anchored>
          <left offset="15" />
          <right offset="-15" />
          <bottom offset="-10" />
        </anchored>
        <datasource>.notelist</datasource>
        <class>char_note</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_alternating>
      <scrollbar_list />
        
    </sheetdata>
  </windowclass>

  <!-- Note entry -->
  <windowclass name="char_note">
    <margins control="0,0,0,2" />
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "name", "idelete" }, bReadOnly);
      end
    </script>
    <sheetdata>
      <anchor_listitem_left_sm />
      <anchor_listitem_right_sm />

      <button_listitem_idelete_left name="idelete" />

      <linkc_listitem_left name="shortcut">
        <class>charnote</class>
        <tabtarget prev="name" />
      </linkc_listitem_left>

      <string_listitem_center name="name">
        <delaykeyupdate />
        <tabtarget next="shortcut" />
      </string_listitem_center>

      </sheetdata>
  </windowclass>

</root>
