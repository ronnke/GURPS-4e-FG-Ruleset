<root>

  <windowclass name="npc_combat">
    <script file="campaign/scripts/npc_combat.lua" />
    <sheetdata>
      <anchor_content_top />
      <anchor_content_bottom />

      <sub_content_top name="defenses">
        <anchored to="contentanchor" position="below">
          <left anchor="center" offset="-125" />
          <right anchor="center" offset="125" />
        </anchored>
        <class>npc_content_defenses</class>
      </sub_content_top>

      <sub_content name="combat">
        <class>npc_combat_contents</class>
      </sub_content>

    </sheetdata>
  </windowclass>

  <windowclass name="npc_combat_contents">
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        updateVisibility(bReadOnly);
      end
      function updateVisibility(bReadOnly)
        local node = getDatabaseNode();
        if not node then
          return;
        end

        local bShowAll = not bReadOnly;
        meleecombat.setVisible(bShowAll or CharManager.hasMeleeWeapons(node));
        rangedcombat.setVisible(bShowAll or CharManager.hasRangedWeapons(node));
        defenses.setVisible(bShowAll or CharManager.hasDefenses(node));
      end
    </script>
    <sheetdata>
      <anchor_content_top />

      <sub_content_top name="meleecombat">
        <anchored>
          <top position="relative" postoffset="10" />
        </anchored>
        <class>npc_list_meleeweapon</class>
      </sub_content_top>
      <sub_content_top name="rangedcombat">
        <anchored>
          <top position="relative" postoffset="10" />
        </anchored>
        <class>npc_list_rangedweapon</class>
      </sub_content_top>
      <sub_content_top name="defenses">
        <anchored>
          <top position="relative" postoffset="10" />
        </anchored>
        <class>npc_list_defense</class>
      </sub_content_top>
      
    </sheetdata>
  </windowclass>

  <windowclass name="npc_content_defenses" copy="common_content_defenses">
		<script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "dodge", "parry", "block", "dr" }, bReadOnly);
      end
    </script>
  </windowclass>

  <windowclass name="npc_list_meleeweapon" copy="common_list_meleeweapon">
    <sheetdata>

      <list_content_labeled_alternating_top name="list">
        <datasource>.combat.meleecombatlist</datasource>
        <class>npc_listitem_meleeweapon</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating_top>

      <spacer_list_content_link_label_left name="spacer_shortcut" merge="delete"/>
      <label_list_content_string_right name="label_tl" merge="delete" />
      <label_list_content_string_right name="label_cost" merge="delete" />

    </sheetdata>
  </windowclass>

  <windowclass name="npc_listitem_meleeweapon" copy="common_listitem_meleeweapon">
    <sheetdata>

      <link_listitem_left name="shortcut" merge="delete" />
      <string_listitem_right name="tl" merge="delete" />
      <string_listitem_right name="cost" merge="delete" />

      <!--Modes Section-->
      <sub_content_section_top name="modes">
        <class>npc_list_meleeweaponmode</class>
      </sub_content_section_top>

    </sheetdata>
  </windowclass>

  <windowclass name="npc_list_meleeweaponmode" copy="common_list_meleeweaponmode">
    <sheetdata>

      <list_content_labeled_alternating_top name="list">
        <datasource>.meleemodelist</datasource>
        <class>npc_listitem_meleeweaponmode</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating_top>

    </sheetdata>
  </windowclass>

  <windowclass name="npc_listitem_meleeweaponmode" copy="common_listitem_meleeweaponmode" />

  <windowclass name="npc_list_rangedweapon" copy="common_list_rangedweapon">
    <sheetdata>

      <list_content_labeled_alternating_top name="list">
        <datasource>.combat.rangedcombatlist</datasource>
        <class>npc_listitem_rangedweapon</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating_top>

      <spacer_list_content_link_label_left name="spacer_shortcut" merge="delete" />
      <label_list_content_string_right name="label_tl" merge="delete" />
      <label_list_content_string_right name="label_lc" merge="delete" />

    </sheetdata>
  </windowclass>

  <windowclass name="npc_listitem_rangedweapon" copy="common_listitem_rangedweapon">
    <sheetdata>

      <link_listitem_left name="shortcut" merge="delete" />
      <string_listitem_right name="tl" merge="delete" />
      <string_listitem_right name="lc" merge="delete" />

      <!--Modes Section-->
      <sub_content_section_top name="modes">
        <class>npc_list_rangedweaponmode</class>
      </sub_content_section_top>

    </sheetdata>
  </windowclass>

  <windowclass name="npc_list_rangedweaponmode" copy="common_list_rangedweaponmode">
    <sheetdata>

      <list_content_noscroll_alternating_top name="list">
        <datasource>.rangedmodelist</datasource>
        <class>npc_listitem_rangedweaponmode</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_noscroll_alternating_top>

    </sheetdata>
  </windowclass>

  <windowclass name="npc_listitem_rangedweaponmode" copy="common_listitem_rangedweaponmode">
    <sheetdata>

      <!--Details Section-->
      <sub_content_top name="details">
        <class>npc_rangedweaponmode_detail</class>
      </sub_content_top>

    </sheetdata>
  </windowclass>

  <windowclass name="npc_rangedweaponmode_detail" copy="common_rangedweaponmode_detail" />

  <windowclass name="npc_list_defense" copy="common_list_defense">
    <sheetdata>

      <list_content_labeled_alternating_top name="list">
        <datasource>.combat.defenseslist</datasource>
        <class>npc_listitem_defense</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating_top>

      <spacer_list_content_link_label_left name="spacer_shortcut" merge="delete" />

    </sheetdata>
  </windowclass>

  <windowclass name="npc_listitem_defense" copy="common_listitem_defense">
    <sheetdata>

      <link_listitem_left name="shortcut" merge="delete"/>

    </sheetdata>
  </windowclass>

</root>
