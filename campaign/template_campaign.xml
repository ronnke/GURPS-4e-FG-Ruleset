  <template name="button_listitem_mod_right">
    <button_listitem_roll_right name="button_mod">
      <script>
        function onDragStart(button, x, y, draginfo)
          if targetvalue[1] and window[targetvalue[1]] then
              draginfo.setType("number");
              draginfo.setDescription(targetname[1]);
              draginfo.setStringData(targetname[1]);
              draginfo.setNumberData(window[targetvalue[1]].getValue());
          end
          return true;
        end

        function onButtonPress()
          if targetvalue[1] and window[targetvalue[1]] then
            ModifierStack.addSlot(targetname[1], window[targetvalue[1]].getValue());
          end
          return true;
        end
      </script>
      <icon normal="button_roll" pressed="button_roll_down" />
    </button_listitem_roll_right>
  </template>
