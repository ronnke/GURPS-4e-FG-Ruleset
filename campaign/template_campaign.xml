  <template name="button_listitem_isection_right">
    <button_listitem_right name="isection">
      <script>
        function onInit()
          if target[1] and window[target[1]] then
            window[target[1]].setVisible(getValue() == 1);
          end
        end
        function onValueChanged()
          if target[1] and window[target[1]] then
            window[target[1]].setVisible(getValue() == 1);
          end
        end
      </script>
    </button_listitem_right>
  </template>  
