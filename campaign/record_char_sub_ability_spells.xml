<root>

  <template name="string_spelldetail_right">
    <simplestring>
      <frame mergerule="replace" name="fielddark" offset="10,5,10,5" hidereadonly="true" />
      <stateframe>
        <keyedit name="fieldfocus" offset="10,5,10,5" />
        <hover name="fieldfocus" offset="10,5,10,5" hidereadonly="true" />
        <drophilight name="fieldfocus" offset="10,5,10,5" hidereadonly="true" />
      </stateframe>
      <nodrag />
      <center />
      <delaykeyupdate />
      <noscroll />
    </simplestring>
  </template>

    <template name="string_spelldetail_left">
    <simplestring>
      <frame mergerule="replace" name="fielddark" offset="10,5,10,5" hidereadonly="true" />
      <stateframe>
        <keyedit name="fieldfocus" offset="10,5,10,5" />
        <hover name="fieldfocus" offset="10,5,10,5" hidereadonly="true" />
        <drophilight name="fieldfocus" offset="10,5,10,5" hidereadonly="true" />
      </stateframe>
      <nodrag />
      <center />
      <delaykeyupdate />
    </simplestring>
  </template>

  <template name="string_spelldetail_center">
    <simplestring>
      <frame mergerule="replace" name="fielddark" offset="10,5,10,5" hidereadonly="true" />
      <stateframe>
        <keyedit name="fieldfocus" offset="10,5,10,5" />
        <hover name="fieldfocus" offset="10,5,10,5" hidereadonly="true" />
        <drophilight name="fieldfocus" offset="10,5,10,5" hidereadonly="true" />
      </stateframe>
      <multilinespacing>20</multilinespacing>
      <nodrag />
      <center />
      <delaykeyupdate />
    </simplestring>
  </template>

  <template name="label_fieldtop_bold_underline">
    <label_fieldtop name="label">
      <font>sheetlabel</font>
      <underline />
    </label_fieldtop>
  </template>


  <windowclass name="charsheet_sub_ability_spells">
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "list_iadd", }, bReadOnly);
      end
      function onDrop(x, y, draginfo)
				if draginfo.isType("shortcut") and LibraryDataGURPS4e.isSpell(draginfo.getDatabaseNode()) then
					return CharManager.addAbility(getDatabaseNode(), draginfo.getDatabaseNode());
				end
      end
    </script>
		<sheetdata>
      <anchor_content_top />
      <anchor_content_bottom />

      <frame_char name="frame">
        <anchored position="insidetopleft">
          <right />
          <bottom />
        </anchored>
      </frame_char>

      <label_charframetop name="header">
        <anchored to="contentanchor" height="20">
          <top relation="relative" offset="25" postoffset="2" />
          <left offset="10" />
          <right offset="-10" />
        </anchored>
        <static textres="char_label_abilities_spells" />
        <icons>char_abilities_spells</icons>
      </label_charframetop>

      <button_iadd name="list_iadd">
        <anchored to="header" position="insidetopright" offset="5,0" />
        <target>list</target>
      </button_iadd>

      <list_content_labeled_alternating name="list">
        <anchored>
          <left offset="15" />
          <right offset="-15" />
          <bottom offset="-10" />
        </anchored>
        <datasource>.abilities.spelllist</datasource>
        <class>char_spell</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating>
      <scrollbar_list />

      <anchor_list_content_label_left />
      <anchor_list_content_label_right />
      <spacer_list_content_idelete_label_left name="idelete_header" />
      <spacer_list_content_button_label_left name="spacer_shortcut" />

      <label_list_content_number_right name="label_points">
        <anchored width="25" />
        <center />
        <static textres="char_label_abilities_points" />
      </label_list_content_number_right>

      <label_list_content_number_right name="label_type">
        <anchored width="40" />
        <center />
        <static textres="char_label_abilities_type" />
      </label_list_content_number_right>

      <label_list_content_number_right name="label_class">
        <anchored width="75" />
        <center />
        <static textres="char_label_abilities_class" />
      </label_list_content_number_right>

      <spacer_list_content_button_label_right name="spacer_roll" />

      <label_list_content_number_right name="label_level">
        <anchored width="25" />
        <center />
        <static textres="char_label_abilities_level" />
      </label_list_content_number_right>

      <spacer_list_content_button_label_right name="imodifier_header" />
      <spacer_list_content_button_label_right name="idetail_header" />
      
      <label_list_content_noframe name="label_name">
        <center />
        <static textres="char_label_abilities_name" />
      </label_list_content_noframe>

		</sheetdata>
	</windowclass>

	<windowclass name="char_spell">
		<script>
			function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "name", "points", "idelete" }, bReadOnly);
      end
		</script>
		<sheetdata>
      <anchor_content_top />
      <anchor_listitem_left_sm />
      <anchor_listitem_right_sm />

      <button_listitem_idelete_left name="idelete" />

      <linkc_listitem_left name="shortcut">
        <class>ability_spell</class>
        <tabtarget prev="points" />
      </linkc_listitem_left>

      <number_listitem_right name="points">
        <anchored width="25" />
        <frame mergerule="replace" name="fielddark" offset="5,5,5,5" hidereadonly="true" />
        <color>#808080</color>
        <tabtarget next="shortcut" prev="relativelevel" />
      </number_listitem_right>

      <string_listitem_right_noframe_static name="type">
        <anchored width="40" />
        <center />
        <tabtarget next="relativelevel" prev="button_roll" />
      </string_listitem_right_noframe_static>

      <string_listitem_right_noframe_static name="class">
        <anchored width="75" />
        <center />
        <tabtarget next="points" prev="type" />
      </string_listitem_right_noframe_static>

      <button_listitem_rollable_right name="button_roll">
        <rollable_button_spell />
        <tooltip textres="char_tooltip_spell" />
        <tabtarget next="type" prev="level" />
      </button_listitem_rollable_right>

      <number_listitem_right_noframe_static name="level">
        <anchored width="25" />
        <tabtarget next="button_roll" prev="imodifier" />
      </number_listitem_right_noframe_static>

      <button_listitem_isection_right name="imodifier">
        <state icon="modifiers" tooltipres="char_tooltip_modifiers" merge="resetandadd" />
        <state icon="modifiers_down" merge="add" />
        <target>modifiers</target>
        <tabtarget next="level" prev="name" />
      </button_listitem_isection_right>

      <button_listitem_isection_right name="idetails">
        <state icon="details" tooltipres="char_tooltip_details" merge="resetandadd" />
        <state icon="details_down" merge="add" />
        <target>details</target>
        <tabtarget next="level" prev="name" />
      </button_listitem_isection_right>

      <string_listitem_center name="name">
        <delaykeyupdate />
        <tabtarget next="imodifier" />
      </string_listitem_center>

      <spacer_content_top name="spacer_section">
        <anchored height="20" />
      </spacer_content_top>

      <!--Spell Detail Section-->
      <sub_content_section_top name="details">
        <class>char_section_spelldetails</class>
      </sub_content_section_top>

      <!--Modifiers Section-->
      <sub_content_section_top name="modifiers">
        <class>char_section_modifiers</class>
      </sub_content_section_top>

      <spacer_content_top name="spacer_bottom" />
        
    </sheetdata>
	</windowclass>


  <windowclass name="char_section_spelldetails">
    <margins control="0,0,0,2" />
    <script>
			function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "page", "college", "resist", "costmaintain", "duration", "time" }, bReadOnly);
      end
		</script>
    <sheetdata>
      <anchor_content_top />

      <!-- Spell Details Labels -->
      <label_content_column name="time_label">
        <static textres="ability_spelltimetocast_label" />
      </label_content_column>
      <string_content_columnh name="time" />

      <label_content_column name="duration_label">
        <static textres="ability_spellduration_label" />
      </label_content_column>
      <string_content_columnh name="duration" />

      <label_content_column name="costmaintain_label">
        <static textres="ability_spellcostmaintain_label" />
      </label_content_column>
      <string_content_columnh name="costmaintain" />

      <label_content_column name="resist_label">
        <static textres="ability_spellresist_label" />
      </label_content_column>
      <string_content_columnh name="resist" />

      <label_content_column name="college_label">
        <static textres="ability_spellcollege_label" />
      </label_content_column>
      <string_content_columnh name="college" />

      <label_content_column name="page_label">
        <static textres="ability_page_label" /> 
      </label_content_column>
      <string_content_columnh name="page" />

    </sheetdata>
  </windowclass>
  
</root>
