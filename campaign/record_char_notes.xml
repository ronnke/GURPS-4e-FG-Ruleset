<root>
    <windowclass name="charsheet_notes">
		<sheetdata>

      <!-- NOTES -->
      <charsheet_sub_notes name="notes">
        <anchored position="insidetopleft" offset="0,0" height="245">
          <right offset="-165" />
        </anchored>
        <tabtarget prev="summary" />
      </charsheet_sub_notes>

      <!-- POINT SUMMARY -->
      <charsheet_sub_summary name="summary">
        <anchored position="insidetopright" width="165" height="245">
          <right />
        </anchored>
        <tabtarget next="notes" prev="description" />
      </charsheet_sub_summary>

      <!-- DESCRIPTION -->
      <charsheet_sub_description name="description">
        <anchored position="insidetopleft" offset="0,245">
          <left />
          <right />
          <bottom />
        </anchored>
        <tabtarget next="summary" />
      </charsheet_sub_description>

    </sheetdata>
	</windowclass>

</root>
