<root>
  
	<windowclass name="common_list_meleeweapon">
		<script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "list_iadd", }, bReadOnly);
      end
      function onDrop(x, y, draginfo)
        if not draginfo.isType("shortcut") then
          return;
        end

        local _, sRecord = draginfo.getShortcutData();
        if LibraryDataGURPS4e.isMeleeWeapon(sRecord) then
          return ItemManager.handleAnyDrop(getDatabaseNode(), draginfo);
        end
      end      
    </script>
		<sheetdata>
      <anchor_content_top />
      <anchor_content_bottom />

      <label_charframetop name="header">
        <anchored to="contentanchor" height="20">
          <top relation="relative" offset="2" postoffset="2" />
          <left offset="10" />
          <right offset="-10" />
        </anchored>
        <static textres="char_label_combat_melee" />
        <icons>char_combat_melee</icons>
      </label_charframetop>

      <button_iadd name="list_iadd">
        <anchored to="header" position="insidetopright" offset="5,0" />
        <target>list</target>
      </button_iadd>

      <list_content_labeled_alternating_top name="list">
        <anchored>
          <left offset="5" />
          <right offset="-5" />
        </anchored>
        <datasource>.combat.meleecombatlist</datasource>
        <class>common_listitem_meleeweapon</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating_top>
      <scrollbar_list />

      <anchor_list_content_label_left />
      <anchor_list_content_label_right />
      <spacer_list_content_idelete_label_left name="idelete_header" />
      <spacer_list_content_link_label_left name="spacer_shortcut" />

      <label_list_content_string_right name="label_tl">
        <anchored width="20" />
        <center />
        <static textres="char_label_tl" />
      </label_list_content_string_right>

      <label_list_content_string_right name="label_cost">
        <anchored width="40" />
        <center />
        <static textres="char_label_cost" />
      </label_list_content_string_right>

      <label_list_content_string_right name="label_weight">
        <anchored width="50" />
        <center />
        <static textres="char_label_weight" />
      </label_list_content_string_right>

      <label_list_content_string_right name="label_st">
        <anchored width="20" />
        <center />
        <static textres="char_label_st" />
      </label_list_content_string_right>

      <spacer_list_content_button_label_right name="spacer_modifiers" />
      <spacer_list_content_button_label_right name="spacer_modes" />

      <label_list_content_noframe name="label_weapon">
        <center />
        <static textres="char_label_weapon" />
      </label_list_content_noframe>
			
		</sheetdata>
	</windowclass>

	<windowclass name="common_listitem_meleeweapon">
    <script>
			function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "name", "st", "weight", "cost", "tl", "shortcut", "idelete" }, bReadOnly);
      end
		</script>
    <sheetdata>
      <anchor_content_top />
      <anchor_listitem_left_sm />
      <anchor_listitem_right_sm />

      <button_listitem_idelete_left name="idelete" />
      
      <link_listitem_left name="shortcut">
        <tabtarget prev="tl" />
      </link_listitem_left>
      
      <string_listitem_right name="tl">
        <anchored width="20" />
        <center />
        <tabtarget next="shortcut" prev="cost" />
      </string_listitem_right>

      <string_listitem_right name="cost">
        <anchored width="40" />
        <center />
        <tabtarget next="tl" prev="weight" />
      </string_listitem_right>

      <string_listitem_right name="weight">
        <anchored width="50" />
        <center />
        <tabtarget next="cost" prev="st" />
      </string_listitem_right>

      <string_listitem_right name="st">
        <anchored width="20" />
        <center />
        <tabtarget next="weight" prev="imodifier" />
      </string_listitem_right>

      <button_listitem_isection_right name="imodifier">
        <state icon="modifiers" tooltipres="char_tooltip_modifiers" merge="resetandadd" />
        <state icon="modifiers_down" merge="add" />
        <target>modifiers</target>
        <tabtarget next="st" prev="imodes" />
      </button_listitem_isection_right>

      <button_listitem_isection_right name="imodes">
        <state icon="weapon_modes" tooltipres="char_tooltip_weaponmodes" merge="resetandadd" />
        <state icon="weapon_modes_down" merge="add" />
        <target>modes</target>
        <tabtarget next="imodifier" prev="name" />
      </button_listitem_isection_right>

      <string_listitem_narrow_center name="name">
        <delaykeyupdate />
        <tabtarget next="imodes" />
      </string_listitem_narrow_center>

      <spacer_content_top name="spacer_section">
        <anchored height="20" />
      </spacer_content_top>

      <!--Modes Section-->
      <sub_content_section_top name="modes">
        <class>common_list_meleeweaponmode</class>
      </sub_content_section_top>

      <!--Modifiers Section-->
      <sub_content_section_top name="modifiers">
        <class>common_list_modifier</class>
      </sub_content_section_top>

      <spacer_content_top name="spacer_bottom" />
			
		</sheetdata>
	</windowclass>

  <windowclass name="common_list_meleeweaponmode">
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "list_iadd", }, bReadOnly);
      end
    </script>
    <sheetdata>
      <anchor_content_top />
      <anchor_content_bottom />

      <frame_char name="frame">
        <anchored position="over" />
      </frame_char>

      <list_content_noscroll_alternating_top name="list">
        <anchored>
          <top position="relative" offset="10" />
        </anchored>
        <datasource>.meleemodelist</datasource>
        <class>common_listitem_meleeweaponmode</class>
        <sortby><control>name</control></sortby>
        <newfocus>name</newfocus>
      </list_content_noscroll_alternating_top>

      <button_iadd name="list_iadd">
        <anchored to="list" position="belowright" offset="5,5" />
        <target>list</target>
      </button_iadd>

      <anchor_list_content_label_left_sm />
      <anchor_list_content_label_right_sm />
      <spacer_list_content_idelete_label_left name="idelete_header" />

      <label_listitem_string_narrow_right_sm name="label_parry">
        <anchored width="30" />
        <center />
        <static textres="char_label_parry" />
      </label_listitem_string_narrow_right_sm>

      <label_listitem_string_narrow_right_sm name="label_reach">
        <anchored width="30" />
        <center />
        <static textres="char_label_reach" />
      </label_listitem_string_narrow_right_sm>

      <label_listitem_string_narrow_right_sm name="label_damage">
        <anchored width="100" />
        <center />
        <static textres="char_label_damage" />
      </label_listitem_string_narrow_right_sm>

      <label_listitem_number_narrow_right_sm name="label_lvl">
        <anchored width="20" />
        <static textres="char_label_level" />
      </label_listitem_number_narrow_right_sm>

      <spacer_list_content_button_label_right name="spacer_parry" />
      <spacer_list_content_button_label_right name="spacer_damage" />
      <spacer_list_content_button_label_right name="spacer_attack" />

      <label_listitem_string_narrow_noframe_sm name="label_modes">
        <center />
        <static textres="char_label_mode" />
      </label_listitem_string_narrow_noframe_sm>

    </sheetdata>
  </windowclass>

  <windowclass name="common_listitem_meleeweaponmode">
    <margins control="0,0,0,2" />
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
        WindowManager.callSafeControlsSetLockMode(self, { "name", "level", "damage", "reach", "parry", "idelete" }, bReadOnly);
      end
    </script>
    <sheetdata>
      <anchor_content_top />
      <anchor_listitem_left_sm />
      <anchor_listitem_right_sm />

      <button_listitem_idelete_left name="idelete" />

      <string_listitem_narrow_right name="parry">
        <anchored width="30" />
        <center />
        <tabtarget prev="reach" />
      </string_listitem_narrow_right>

      <string_listitem_narrow_right name="reach">
        <anchored width="30" />
        <center />
        <tabtarget next="parry" prev="damage" />
      </string_listitem_narrow_right>

      <string_listitem_narrow_right name="damage">
        <anchored width="100" />
        <tabtarget next="reach" prev="level" />
      </string_listitem_narrow_right>

      <number_listitem_narrow_right name="level">
        <anchored width="20" />
        <tabtarget next="damage" prev="button_parry" />
      </number_listitem_narrow_right>

      <button_listitem_rollable_right name="button_parry">
        <rollable_button_weaponparry />
        <icon normal="button_action_parry" pressed="button_action_parry_down" />
        <tooltip textres="char_tooltip_roll_parry" />
        <tabtarget next="level" prev="button_damage" />
      </button_listitem_rollable_right>

      <button_listitem_rollable_right name="button_damage">
        <rollable_button_damage />
        <icon normal="button_action_damage" pressed="button_action_damage_down" />
        <tooltip textres="char_tooltip_roll_damage" />
        <tabtarget next="button_parry" prev="button_attack" />
      </button_listitem_rollable_right>

      <button_listitem_rollable_right name="button_attack">
        <rollable_button_melee />
        <icon normal="button_action_attack" pressed="button_action_attack_down" />
        <tooltip textres="char_tooltip_roll_attack" />
        <tabtarget next="button_damage" prev="name" />
      </button_listitem_rollable_right>

      <string_listitem_narrow_center name="name">
        <delaykeyupdate />
        <tabtarget next="button_attack" />
      </string_listitem_narrow_center>

    </sheetdata>
  </windowclass>

</root>
