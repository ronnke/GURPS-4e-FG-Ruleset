    </sheetdata>
  </windowclass>

  <windowclass name="char_rangedweaponmode_detail" copy="common_rangedweaponmode_detail" />

  <windowclass name="char_list_defense" copy="common_list_defense">
    <sheetdata>

      <list_content_labeled_alternating_top name="list">
        <datasource>.combat.defenseslist</datasource>
        <class>char_listitem_defense</class>
