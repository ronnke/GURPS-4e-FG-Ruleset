<root>
	<windowclass name="charsheet_combat">
    <script>
      function onDrop(x, y, draginfo)
        if not draginfo.isType("shortcut") then
          return;
        end

        local _, sRecord = draginfo.getShortcutData();
        local bIsWeaponOrDefense =
          LibraryDataGURPS4e.isMeleeWeapon(sRecord) or
          LibraryDataGURPS4e.isRangedWeapon(sRecord) or
          LibraryDataGURPS4e.isDefense(sRecord);

        if bIsWeaponOrDefense then
          return ItemManager.handleAnyDrop(getDatabaseNode(), draginfo);
        end
      end      
    </script>
		<sheetdata>
      <anchor_content_top />
      <anchor_content_bottom />

      <charsheet_sub_injuryandfatigue name="injuryandfatigue">
        <anchored position="insidetopleft" offset="0,0" />
        <tabtarget next="defenses" />
      </charsheet_sub_injuryandfatigue>

      <charsheet_sub_defenses name="defenses">
        <anchored to="injuryandfatigue" position="right" />
        <tabtarget next="combat" prev="injuryandfatigue" />
      </charsheet_sub_defenses>

      <sub_content_framed_groupbox name="combat">
        <anchored>
          <top offset="115" />
        </anchored>
        <class>charsheet_combat_contents</class>
      </sub_content_framed_groupbox>
      <scrollbar>
        <anchored to="combat" />
        <target>combat</target>
      </scrollbar>

    </sheetdata>
	</windowclass>

  <windowclass name="charsheet_combat_contents">
    <script>
      function onInit()
        self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
      end
      function onLockModeChanged(bReadOnly)
	      updateVisibility(bReadOnly);
      end      
      function updateVisibility(bReadOnly)
	      local node = getDatabaseNode();
	      if not node then
		      return;
	      end

        local bShowAll = not bReadOnly;
        meleecombat.setVisible(bShowAll or CharManager.hasMeleeWeapons(node));
        rangedcombat.setVisible(bShowAll or CharManager.hasRangedWeapons(node));
        defenses.setVisible(bShowAll or CharManager.hasDefenses(node));
      end
    </script>
    <sheetdata>
      <anchor_content_top />

      <sub_content_top name="meleecombat">
        <anchored>
          <top position="relative" postoffset="10" />
        </anchored>
        <class>char_list_meleeweapon</class>
      </sub_content_top>
      <sub_content_top name="rangedcombat">
        <anchored>
          <top position="relative" postoffset="10" />
        </anchored>
        <class>char_list_rangedweapon</class>
      </sub_content_top>
      <sub_content_top name="defenses">
        <anchored>
          <top position="relative" postoffset="10" />
        </anchored>
        <class>char_list_defense</class>
      </sub_content_top>
    </sheetdata>
  </windowclass>

  <windowclass name="char_list_meleeweapon" copy="common_list_meleeweapon">
    <sheetdata>

      <list_content_labeled_alternating_top name="list">
        <datasource>.combat.meleecombatlist</datasource>
        <class>char_listitem_meleeweapon</class>
        <sortby>
          <control>name</control>
        </sortby>
        <newfocus>name</newfocus>
      </list_content_labeled_alternating_top>

    </sheetdata>
  </windowclass>

  <windowclass name="char_listitem_meleeweapon" copy="common_listitem_meleeweapon">
    <sheetdata>

      <!--Modes Section-->
      <sub_content_section_top name="modes">
        <class>npc_list_meleeweaponmode</class>
      </sub_content_section_top>

    </sheetdata>
  </windowclass>

  <windowclass name="char_list_meleeweaponmode" copy="common_list_meleeweaponmode">
