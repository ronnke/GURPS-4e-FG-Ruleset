<root>
  <template name="charsheet_sub_injuryandfatigue">
    <subwindow>
      <anchored position="insidetopleft" width="220" height="105" />
      <class>char_header_injuryandfatigue</class>
      <activate />
    </subwindow>
  </template>

  <windowclass name="char_header_injuryandfatigue">
    <sheetdata>
      <anchor_content_top />

      <frame_char name="frame">
        <anchored position="over" />
      </frame_char>

      <label_charframetop name="header">
        <anchored to="contentanchor" height="20">
          <top relation="relative" offset="2" postoffset="7" />
          <left offset="10" />
          <right offset="-10" />
        </anchored>
        <static textres="char_label_combat_injuryandfatigue" />
      </label_charframetop>

      <sub_content_top name="defenses">
        <anchored to="header" position="below">
          <top offset="5" />
          <left anchor="center" offset="-100" />
          <right anchor="center" offset="100" />
        </anchored>
        <class>common_content_injuryandfatigue</class>
      </sub_content_top>
    </sheetdata>
  </windowclass>
	
</root>
