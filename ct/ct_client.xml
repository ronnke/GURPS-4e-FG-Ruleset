<root>
	<windowclass name="combattracker_client" merge="join">
		<placement>
			<size width="500" height="500" />
		</placement>
		<sizelimits>
			<minimum width="450" height="350" />
			<dynamic />
		</sizelimits>
    <script file="ct/scripts/clientct_window.lua" />
  </windowclass>
  
  <windowclass name="sub_ct_header_client" merge="join">
    <script file="ct/scripts/clientct_header.lua" />
    <sheetdata>
      <label_ct_header_init name="label_init" merge="delete" />

      <spacer_ct_header_status name="label_status_spacer" insertbefore="label_name" />
      <label_ct_header_status name="label_status" insertbefore="label_name" />
      <label_ct_header_fatigue name="label_fatigue" insertbefore="label_name" />
      <label_ct_header_injury name="label_injury" insertbefore="label_name" />
      <label_ct_header_fps name="label_fps" insertbefore="label_name" />
      <label_ct_header_hps name="label_hps" insertbefore="label_name" />
      <label_ct_header_speed name="label_speed" insertbefore="label_name" />
    </sheetdata>
  </windowclass>
</root>
