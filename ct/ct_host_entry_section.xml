  <windowclass name="ct_section_damage">
    <script file="ct/scripts/ct_damage.lua" />
    <sheetdata>
      <icon_ct_section name="icon_section">
        <icon>roll_damage</icon>
      </icon_ct_section>

      <anchor_ct_section name="anchor_section" />

      <label name="label_damage">
        <anchored to="anchor_section">
          <top anchor="bottom" relation="relative" offset="10" />
          <left offset="5" />
        </anchored>
        <static>Damage:</static>
      </label>
      <number_ct name="damage">
        <anchored to="label_damage" position="right" offset="5" width="40" height="20" />
        <description textres="ct_label_damage" />
        <script>
          function onValueChanged()
            window.updateInjury();
          end
        </script>
        <default>0</default>
        <min>0</min>
        <center />
      </number_ct>

      <label name="label_type">
        <anchored to="damage" position="right" offset="20" />
        <static>Type:</static>
      </label>
      <simplestring name="damagetype">
        <anchored to="label_type" position="right" offset="5" width="70" height="20" />
      </simplestring>

      <label name="label_hitlocation">
        <anchored to="damagetype" position="right" offset="20" />
        <static>Hit Location:</static>
      </label>
      <comboboxc name="hitlocation">
        <anchored to="label_hitlocation" position="right" offset="10" width="80" height="20" />
        <listdirection>down</listdirection>
        <script>
					function onInit()
	          if super and super.onInit then
		          super.onInit();
	          end
            addItems(DataCommon.aHitLocationData);
            setValue("Torso");
          end

          function onValueChanged()
            window.updateInjury();
          end
				</script>
        <center />
      </comboboxc>

      <label name="label_dr">
        <anchored to="anchor_section">
          <top anchor="bottom" relation="relative" offset="5" />
          <left offset="5" />
        </anchored>
        <static>DR:</static>
      </label>
      <number_ct name="dr">
        <anchored to="label_dr" position="right" offset="5" width="50" height="20" />
        <script>
          function onValueChanged()
            window.updateInjury();
          end
        </script>
        <center />
        <default>0</default>
        <min>0</min>
      </number_ct>

      <label name="label_hardened">
        <anchored to="dr" position="right" offset="20" />
        <static>Hardened:</static>
      </label>
      <comboboxc name="hardened">
        <anchored to="label_hardened" position="right" offset="10" width="80" height="20" />
        <listdirection>down</listdirection>
        <script>
					function onInit()
	          if super and super.onInit then
		          super.onInit();
	          end
						addItems(DataCommon.aHardenedData);
            setValue("None");
					end

          function onValueChanged()
            window.updateInjury();
          end
        </script>
        <center />
      </comboboxc>

      <label name="label_armordivisor">
        <anchored to="hardened" position="right" offset="20" />
        <static>Armor Divisor:</static>
      </label>
      <simplestring name="armordivisortext">
        <anchored to="label_armordivisor" position="right" offset="5" width="40" height="20" />
      </simplestring>


      <label name="label_injurytolerance">
        <anchored to="anchor_section">
          <top anchor="bottom" relation="relative" offset="5" />
          <left offset="5" />
        </anchored>
        <static>Injury Tolerance:</static>
      </label>
      <comboboxc name="injurytolerance">
        <anchored to="label_injurytolerance" position="right" offset="10" width="120" height="20" />
        <listdirection>down</listdirection>
        <script>
					function onInit()
	          if super and super.onInit then
		          super.onInit();
	          end
						addItems(DataCommon.aInjuryToleranceData);
            setValue("None");
					end

          function onValueChanged()
            window.updateInjury();
          end
        </script>
        <center />
      </comboboxc>
      
      <label name="label_injury">
        <anchored to="injurytolerance" position="right" offset="20" />
        <static>Injury</static>
      </label>
      <number_ct name="injury">
        <anchored to="label_injury" position="right" offset="10" width="40" height="20" />
        <description textres="ct_label_injury" />
        <default>0</default>
        <min>0</min>
        <center />
      </number_ct>

      <button_text name="apply">
        <anchored to="injury" position="right" offset="20" width="50" height="20" />
        <tooltip textres="ct_toolip_damage_apply" />
        <state textres="button_apply" />
				<script>
          function onButtonPress()
            window.applyDamage();
          end
        </script>
			</button_text>
      
      <simplestring name="messagetext">
        <anchored to="anchor_section">
          <top anchor="bottom" relation="relative" offset="5" />
          <left offset="5" />
          <right offset="-5" />
        </anchored>
        <font>sheetlabel</font>
        <color>#800000</color>
      </simplestring>

      <buttoncontrol>
        <anchored to="anchor_section" position="righthigh" offset="-15,5" width="20" height="20" />
				<icon normal="button_clear" pressed="button_clear_down" />
				<tooltip textres="ct_toolip_damage_clear" />
				<script>
					function onButtonPress()
						window.removeEntry();
					end
				</script>
			</buttoncontrol>
      
      <genericcontrol name="spacer">
        <anchored to="anchor_section" height="10">
          <top anchor="bottom" relation="relative" />
          <left />
          <right />
        </anchored>
        <disabled />
      </genericcontrol>

      <frame_ct_section name="frame_section">
        <anchored>
          <left parent="icon_section" anchor="right" offset="0" />
          <bottom parent="spacer" />
        </anchored>
      </frame_ct_section>
    </sheetdata>
  </windowclass>
